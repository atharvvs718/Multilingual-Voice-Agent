# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
SARVAM_API_KEY=

# Local Docker Postgres by default; Neon connection string in production
DATABASE_URL=postgresql://voice:voice@127.0.0.1:5432/voice

SARVAM_STT_MODEL=saaras:v4
STT_MODEL=whisper-large-v3
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
VISION_MODEL=qwen/qwen3.8-27b

# The voice selected when the app opens: priya, pooja, neha, shubh or aditya
TTS_VOICE=priya
SARVAM_TTS_MODEL=bulbul:v3

# Optional limits
MAX_TURNS_PER_HOUR=30
MAX_SPOKEN_PER_HOUR=20
# The most voice and listening may cost in a day, in rupees, for all visitors together
DAILY_BUDGET_RUPEES=30
MAX_UPLOADS_PER_HOUR=6
TURN_LOG_DAYS=7
# Set a code to make the app ask for it before use (leave empty for no code)
ACCESS_CODE=
# On a hosting service: 1 proxy in front, and listen on every address. Leave both out on a laptop.
# PROXY_HOPS=1
# HOST=0.0.0.0
API_TIMEOUT_S=15
